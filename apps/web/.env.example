# ─────────────────────────────────────────────────────────────
# REC Code web app (apps/web) — environment
# Copy to apps/web/.env.local for local development (gitignored) and fill
# in the empty values. Validated on first use by src/lib/env.ts.
# Never commit real secrets. Every value below is a development value.
# ─────────────────────────────────────────────────────────────

# PostgreSQL, database `recx` — never the LMS database.
# Local (scripts/dev/wsl-services.sh or compose.yaml): port 5433, because a
# Windows-native Postgres usually owns 5432.
# Production: the PgBouncer (transaction mode) URL, with
#   ?pgbouncer=true&connection_limit=10
DATABASE_URL="postgresql://recx:recx-dev-only@localhost:5433/recx"

# Direct, non-pooled URL. In development there is no PgBouncer, so it equals
# DATABASE_URL. The scheduler falls back to this file in development
# (apps/scheduler/src/config.ts) and uses this variable when present.
DATABASE_URL_DIRECT="postgresql://recx:recx-dev-only@localhost:5433/recx"

# Redis 7: BullMQ queues + progress pub/sub. Transport only; Postgres is truth.
REDIS_URL="redis://127.0.0.1:6379"

# Public URL the app is served from (no trailing slash).
APP_URL="http://localhost:3000"

# Pepper for ipHash = sha256(ip + pepper). A raw IP is never stored.
# Required, at least 16 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_PEPPER=""

# Trust X-Forwarded-For only behind the reverse proxy (Caddy) in production.
TRUST_PROXY="false"

# Test-data store. "local" keeps blobs on disk (path relative to apps/web);
# "s3" uses S3-compatible storage (compose.yaml runs MinIO for this).
TESTDATA_DRIVER="local"
TESTDATA_DIR="../../storage/testdata"
# With TESTDATA_DRIVER="s3" against the compose.yaml MinIO:
# S3_ENDPOINT="http://localhost:9000"
# S3_REGION="us-east-1"
# S3_BUCKET="recx-testdata"
# S3_ACCESS_KEY_ID="recx"
# S3_SECRET_ACCESS_KEY="recx-dev-only-minio"

# ── Seed (apps/web/scripts/seed.ts; docs/RUNBOOK.md §1.3) — local development only
# Passwords for the seeded admin and student accounts: at least 10
# characters with a letter and a number. Leave unset in any shared
# environment; the seed is not a production tool.
SEED_ADMIN_PASSWORD=""
SEED_STUDENT_PASSWORD=""

# The seed registers this judge node (only sha256 of the token is stored).
# apps/judge-worker/.env.local must present the same id and token.
# Generate the token like IP_HASH_PEPPER above.
JUDGE_DEV_NODE_ID="dev-judge-1"
JUDGE_DEV_NODE_TOKEN=""

# Development only: let judge nodes whose kernel hardening check fails (a WSL2
# dev kernel) serve every lane instead of being quarantined. The app refuses
# to start with this set to "true" when NODE_ENV=production.
JUDGE_ALLOW_UNHARDENED_NODES="false"
