{
  "name": "@recx/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "node scripts/copy-monaco.mjs && next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p e2e/tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "size": "node scripts/size-budget.mjs",
    "seed": "tsx --conditions=react-server scripts/seed.ts",
    "postinstall": "node scripts/copy-monaco.mjs",
    "judge-node": "tsx --conditions=react-server scripts/judge-node.ts",
    "validate-and-publish": "tsx --conditions=react-server scripts/validate-and-publish.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-cpp": "^6.0.2",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-java": "^6.0.1",
    "@codemirror/lang-javascript": "^6.2.3",
    "@codemirror/lang-python": "^6.1.7",
    "@codemirror/language": "^6.11.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.0",
    "@lezer/highlight": "^1.2.1",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "6.16.2",
    "@prometheus-io/client": "0.16.1",
    "@recx/db": "workspace:*",
    "@recx/design": "workspace:*",
    "@recx/shared": "workspace:*",
    "@simplewebauthn/browser": "13.1.0",
    "@simplewebauthn/server": "13.1.1",
    "@tanstack/react-virtual": "^3.10.0",
    "bullmq": "^5.56.0",
    "ioredis": "^5.7.0",
    "lucide-react": "^0.544.0",
    "marked": "^16.3.0",
    "monaco-editor": "0.52.2",
    "next": "^15.5.4",
    "pino": "^9.9.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-resizable-panels": "^2.1.7",
    "sanitize-html": "^2.17.0",
    "server-only": "^0.0.1",
    "web-vitals": "^4",
    "yauzl": "3.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/sanitize-html": "^2.16.0",
    "@types/yauzl": "3.4.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
