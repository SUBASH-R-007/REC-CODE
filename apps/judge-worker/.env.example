# ─────────────────────────────────────────────────────────────
# REC Code judge worker (apps/judge-worker) — environment
# Copy to apps/judge-worker/.env.local for local development (gitignored).
# Validated at boot by src/config.ts. Production judge hosts never read a
# file: systemd supplies /etc/recjudge/worker.env (infra/judge/cloud-init.yaml).
#
# Deliberately credential-free: no DATABASE_URL, no auth secret, no storage
# key. The node token is the only secret, and it can only heartbeat, claim a
# job, fetch that job's blobs, post its result and release it.
# ─────────────────────────────────────────────────────────────

# Must match JUDGE_DEV_NODE_ID / JUDGE_DEV_NODE_TOKEN in apps/web/.env.local
# (the seed registers the node with the sha256 of this token).
RECX_NODE_ID="dev-judge-1"
RECX_NODE_TOKEN=""

# The web app's base URL (the /api/judge/* endpoints live there).
# From WSL2 this reaches the Windows dev server only with mirrored
# networking; otherwise use the Windows host's address (docs/RUNBOOK.md).
RECX_APP_URL="http://localhost:3000"

# Redis: BullMQ queues + progress pub/sub.
REDIS_URL="redis://127.0.0.1:6379"

# isolate — Linux / WSL2 with infra/judge/install-isolate.sh applied.
# mock    — Windows development only. Executes nothing and FABRICATES
#           every verdict; the worker refuses to start with it when
#           NODE_ENV=production.
RECX_DRIVER="isolate"

# Concurrent judge slots. Slot N uses isolate boxes BASE+N (run),
# BASE+100+N (compile) and BASE+200+N (checker); BASE + SLOTS <= 100.
RECX_SLOTS="1"
RECX_BOX_BASE="0"

# Which BullMQ queues this node serves (comma-separated). All five:
#   judge-assessment,judge-contest,judge-run,judge-practice,judge-rejudge
RECX_QUEUES="judge-practice,judge-run"

# Blob cache (sha256-verified test data). The Linux default,
# /var/cache/recjudge/blobs, is created by systemd on judge hosts; when you
# run the worker by hand in WSL2, point it somewhere your user can write:
# RECX_CACHE_DIR="/var/tmp/recjudge-blobs"
# RECX_CACHE_MAX_BYTES="42949672960"

# Defaults suit a host prepared by infra/judge/install-isolate.sh.
# RECX_ISOLATE_BIN="isolate"
# RECX_SYNTHETIC_ETC="/var/lib/recjudge/etc"
# LOG_LEVEL="info"

# Development only: take jobs even though this host fails the kernel hardening
# check (WSL2). The worker refuses to boot with this set when NODE_ENV=production.
# RECX_DEV_ALLOW_UNHARDENED_HOST=1
