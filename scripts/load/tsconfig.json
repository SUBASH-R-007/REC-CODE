{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "baseUrl": ".",
    // scripts/load is not a workspace package: its bare type imports resolve
    // to the workspace's own copies. At run time the same packages are
    // loaded through apps/web's dependency tree (burst-plan.ts, webRequire).
    "paths": {
      "zod": ["../../packages/shared/node_modules/zod"],
      "bullmq": ["../../apps/web/node_modules/bullmq"],
      "ioredis": ["../../apps/web/node_modules/ioredis"]
    }
  },
  "include": ["*.ts"]
}
