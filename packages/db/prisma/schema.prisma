// REC Code — database `recx`. Never the LMS database. The LMS stays the
// identity source of record: users arrive by roster sync / on-login upsert
// keyed on collegeId + lmsUserId; REC Code never creates a student itself.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Web: pooled (PgBouncer transaction mode, ?pgbouncer=true&connection_limit=10).
  url       = env("DATABASE_URL")
  // Migrations, scheduler, reconciler: direct, non-pooled (advisory locks,
  // SKIP LOCKED leases).
  directUrl = env("DATABASE_URL_DIRECT")
}

