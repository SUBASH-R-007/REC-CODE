// ── Identity ───────────────────────────────────────────────────────────

model User {
  id             String        @id @default(cuid())
  lmsUserId      String?       @unique
  /// Roll number. The join key with the LMS roster.
  collegeId      String        @unique
  email          String        @unique
  firstName      String
  lastName       String
  /// Public handle for /u/[handle]. Never the roll number.
  handle         String        @unique
  role           Role          @default(STUDENT)
  status         AccountStatus @default(ACTIVE)
  /// Argon2id (m=19456, t=2, p=1). Null for LMS-SSO-only accounts.
  passwordHash   String?
  /// Set when an account is created with an initial password an admin chose.
  /// Every authenticated surface refuses until the holder replaces it
  /// (lib/auth/guards), so a shared initial password is good for exactly one
  /// sign-in per account. A CHECK keeps it false while passwordHash is NULL:
  /// a password you do not have cannot be the one you must change.
  mustChangePassword Boolean   @default(false)
  batchYear      Int?
  departmentCode String?
  section        String?
  lastActiveAt   DateTime?
  lastLoginAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  /// Public profile at /u/[handle]: never email, roll number, department or scores.
  visibility        ProfileVisibility @default(REC_ONLY)
  /// Hidden from peers on leaderboards; still visible to faculty analytics.
  leaderboardOptOut Boolean           @default(false)
  bio               String?
  /// Editor preferences (font size, tab width, keymap) as plain JSON.
  editorPrefs       Json              @default("{}")

  sessions             Session[]
  passwordResets       PasswordReset[]
  submissions          Submission[]
  runRequests          RunRequest[]
  judgeUsage           UserJudgeUsage[]
  quotaOverrides       JudgeQuotaOverride[]
  problemStatuses      UserProblemStatus[]
  activityDays         ActivityDay[]
  stats                UserStats?
  xpEvents             XpEvent[]
  xpBuckets            XpBucket[]
  hintReveals          HintReveal[]
  editorialViews       EditorialView[]
  aiAssists            AiAssist[]
  problemActivity      ProblemActivity[]
  enrollments          StudyPlanEnrollment[]
  bookmarks            Bookmark[]
  notes                Note[]
  notifications        Notification[]
  codeDrafts           CodeDraft[]
  badges               UserBadge[]
  /// ADMIN student-visibility grants (Phase 4). Actor ids elsewhere stay plain strings.
  adminScopes          AdminScope[]
  accommodations       Accommodation[]
  /// Contests (Phase 5). Participation is student data, like submissions and
  /// XP, so it relates to User (onDelete RESTRICT by default) rather than
  /// holding a plain id: a student is never hard-deleted, and past standings
  /// must stay honest.
  contestRegistrations ContestRegistration[]
  contestAttempts      ContestProblemAttempt[]
  contestStandings     ContestStanding[]
  ratingChanges        RatingChange[]
  rating               UserRating?
  /// Sittings of an assessment (Phase 6).
  assessmentAttempts   AssessmentAttempt[]

  deviceRegistrations DeviceRegistration[]
  webAuthnChallenges  WebAuthnChallenge[]

  integrityReviews IntegrityReview[]
  integrityAppeals IntegrityAppeal[] @relation("AppealStudent")

  /// Aptitude practice and full mocks (Phase 7).
  mockAttempts       MockAttempt[]
  aptitudeTopicStats AptitudeUserTopicStat[]

  /// Excused absences, read by the inactivity counter (Phase 8).
  leaveExceptions LeaveException[]
  /// Where they stand with the inactivity policy, and why (Phase 8c).
  restriction  AccountRestriction?
  statusEvents AccountStatusEvent[]

  /// Readiness (Phase 9). Snapshots are never hard-deleted with the student.
  readinessSnapshots ReadinessSnapshot[]
  menteeAssignments  MentorAssignment[] @relation("MenteeAssignments")
  mentorAssignments  MentorAssignment[] @relation("MentorAssignments")
  placementExports   PlacementExport[]  @relation("PlacementExports")
  placementDrives    PlacementDrive[]   @relation("DrivesCreated")
  driveDecisions     DriveEligibilityDecision[] @relation("DriveDecisionsAbout")
  driveDecisionsMade DriveEligibilityDecision[] @relation("DriveDecisionsMade")
  profileExports     ProfileExport[]    @relation("ProfileExports")

  @@index([status, lastActiveAt])
  @@index([batchYear, departmentCode, section])
}

/// Server-side session rows (an admin can force-logout mid-assessment; a JWT
/// cannot). The cookie holds the raw token; only its sha256 is stored.
model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent  String?
  /// sha256(ip + pepper). Never a raw IP.
  ipHash     String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime

  /// Set on the SUPER_ADMIN's own session while it views as another user
  /// (read-only). The foreign key is SetNull, but an ImpersonationSession row
  /// is never deleted (trigger), so the code that ends an impersonation
  /// clears this pointer.
  impersonationId String?               @unique
  impersonation   ImpersonationSession? @relation(fields: [impersonationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
}

/// Append-only. Each UTC day forms a hash chain (prevHash → hash) whose
/// terminal hash is exported off-box. This is tamper-EVIDENT only: a
/// database superuser can still rewrite rows, but not without breaking a
/// chain whose end has already left the machine.
/// Enforced by the database: trigger AuditLog_append_only refuses UPDATE;
/// trigger AuditLog_no_truncate refuses TRUNCATE (20261010100080). Row
/// DELETE stays allowed on purpose: the retention purge deletes rows older
/// than 3 years that are not under legal hold.
/// A one-time link that lets an account set its own password: created by
/// POST /api/auth/forgot-password, spent by POST /api/auth/reset-password.
///
/// It exists because a roster import creates students with `passwordHash`
/// NULL (packages/db ../../apps/web/src/lib/admin/roster.ts) — the LMS is
/// the identity source and no password crosses that boundary — so without
/// this, an imported student has no way to obtain one.
///
/// The token itself is NEVER stored, only sha256(token): the same rule as a
/// session token, a judge node token and a client address. A row is spent by
/// ONE conditional UPDATE (`consumedAt IS NULL`), and a trigger refuses any
/// attempt to un-spend it or to move it to another account.
model PasswordReset {
  id        String @id @default(cuid())
  userId    String
  /// sha256(token). Unique, so a presented token is one indexed lookup.
  tokenHash String @unique
  expiresAt DateTime
  /// Set once, by the UPDATE that spends it. Never cleared (trigger).
  consumedAt DateTime?
  /// sha256(ip + pepper) of whoever asked. Never a raw address.
  requestIpHash String?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model AuditLog {
  id           BigInt           @id @default(autoincrement())
  actorId      String?
  action       String
  entityType   String
  entityId     String?
  targetUserId String?
  sensitivity  AuditSensitivity @default(NORMAL)
  metadata     Json             @default("{}")
  ipHash       String?
  chainDay     String
  prevHash     String
  hash         String
  createdAt    DateTime         @default(now())

  @@index([targetUserId, createdAt])
  @@index([sensitivity, createdAt])
  @@index([chainDay, id])
}

// ── Problems (immutable versions) ──────────────────────────────────────

/// Stable identity + a pointer to the live version. No statement content
/// lives here; title/difficulty are denormalised listing columns refreshed
/// on publish.
model Problem {
  id                 String          @id @default(cuid())
  slug               String          @unique
  displayCode        String          @unique
  title              String
  difficulty         Difficulty
  status             ProblemStatus   @default(DRAFT)
  liveVersionId      String?         @unique
  liveVersion        ProblemVersion? @relation("LiveVersion", fields: [liveVersionId], references: [id])
  /// Optimistic concurrency for publish (flip liveVersionId).
  version            Int             @default(0)
  /// Editorial opens to everyone (in PRACTICE) from this moment; null = never by date.
  editorialVisibleAt DateTime?
  createdById        String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  versions        ProblemVersion[]    @relation("ProblemVersions")
  submissions     Submission[]
  tags            ProblemTag[]
  companyTags     ProblemCompanyTag[]
  stat            ProblemStat?
  statuses        UserProblemStatus[]
  hintReveals     HintReveal[]
  editorialViews  EditorialView[]
  aiAssists       AiAssist[]
  activity        ProblemActivity[]
  studyPlanItems  StudyPlanItem[]
  bookmarks       Bookmark[]
  notes           Note[]
  codeDrafts      CodeDraft[]
  dailyChallenges DailyChallenge[]

  @@index([status, difficulty, displayCode])
  /// Problem search (pg_trgm, created in migration 20261010001004).
  @@index([title(ops: raw("gin_trgm_ops"))], map: "Problem_title_trgm_idx", type: Gin)
}

/// Topic tags (closed 14-topic enum). Problem-level, so retagging never needs a new version.
model ProblemTag {
  problemId String
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  topic     Topic

  @@id([problemId, topic])
  @@index([topic, problemId])
}

/// Placement-cell-curated companies until the InterviewExperience archive
/// (Phase 11) exists; the UI labels these "curated".
model Company {
  id        String              @id @default(cuid())
  slug      String              @unique
  name      String
  curated   Boolean             @default(true)
  createdAt DateTime            @default(now())
  problems  ProblemCompanyTag[]
  placementDrives PlacementDrive[]
}

model ProblemCompanyTag {
  problemId String
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  frequency Int     @default(0)
  source    String  @default("CURATED")

  @@id([problemId, companyId])
  @@index([companyId, frequency(sort: Desc)])
}

/// Maintained in the finalise transaction: acceptance rate is never computed on read.
model ProblemStat {
  problemId      String   @id
  problem        Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  submissions    Int      @default(0)
  accepted       Int      @default(0)
  attempters     Int      @default(0)
  solvers        Int      @default(0)
  acceptanceRate Float    @default(0)
  updatedAt      DateTime @updatedAt
}

/// All content. Frozen (frozenAt set) on publish and immutable thereafter —
/// the repository layer and a database trigger both refuse writes to a frozen
/// version or its children. Edits clone a new DRAFT revision. TRUNCATE of
/// ProblemVersion, each frozen child table and TestBlob is refused
/// (<Table>_no_truncate statement triggers).
model ProblemVersion {
  id                 String        @id @default(cuid())
  problemId          String
  problem            Problem       @relation("ProblemVersions", fields: [problemId], references: [id])
  revision           Int
  status             ProblemStatus @default(DRAFT)
  title              String
  difficulty         Difficulty
  statementMd        String        @db.Text
  constraints        Json          @default("[]")
  ioMode             IoMode
  /// FUNCTION mode: validated by functionSignatureSchema (packages/shared).
  functionSignature  Json?
  compareMode        CompareMode   @default(TOKEN)
  floatEpsilon       Float?
  scoringMode        ScoringMode   @default(ICPC)
  stopOnFirstFailure Boolean       @default(true)
  /// Base (C++) limits; per-language limits arrive with ProblemLanguageLimit.
  timeLimitMs        Int
  memoryLimitKb      Int           @default(262144)
  /// CHECKER compare mode: testlib-compatible checker source (C++20).
  checkerSha256      String?
  /// Pinned testlib toolchain id the checker compiles against.
  testlibId          String?
  /// problems/{problemId}/v{revision}/tests.tar.zst — immutable once written.
  bundleKey          String?
  manifestSha256     String?
  /// Set only by the publish transition (UPDATE of a version whose frozenAt
  /// is null). A version is never INSERTed frozen (guard + trigger).
  frozenAt           DateTime?
  publishedAt        DateTime?
  createdById        String?
  createdAt          DateTime      @default(now())

  // Authoring (Phase 4). Every column below is version content: once
  // frozenAt is set the ProblemVersion_frozen_guard trigger refuses any
  // UPDATE of the row, so these freeze with the version.
  origin               ContentOrigin   @default(FACULTY)
  /// Optimistic concurrency for draft edits; every content edit increments it.
  editSeq              Int             @default(0)
  /// Incremented by edits that change judging (tests, subtasks, reference
  /// solutions, limits, io/compare/scoring, signature, checker).
  /// ValidationRun.judgeSeq records it; runs of an older seq no longer count.
  judgeSeq             Int             @default(0)
  lastEditedById       String?
  updatedAt            DateTime        @default(now()) @updatedAt
  submittedForReviewAt DateTime?
  submittedById        String?
  /// APPROVED = status IN_REVIEW with approvedAt set (CHECK
  /// ProblemVersion_approval_state: approvedAt only with IN_REVIEW or
  /// PUBLISHED). Frozen with the version on publish.
  approvedAt           DateTime?
  approvedById         String?
  /// sha256 of the canonical import package this revision was created from (import idempotency).
  importSha256         String?
  /// Review history (not version content, never frozen).
  reviews              ProblemReview[]

  liveFor            Problem?               @relation("LiveVersion")
  testCases          TestCase[]
  starterCodes       StarterCode[]
  referenceSolutions ReferenceSolution[]
  subtasks           Subtask[]
  languageLimits     ProblemLanguageLimit[]
  hints              Hint[]
  editorial          Editorial?
  submissions        Submission[]
  runRequests        RunRequest[]
  validationRuns     ValidationRun[]
  /// Contests that pin this (frozen) version — Phase 5.
  contestProblems    ContestProblem[]
  AssessmentProblem  AssessmentProblem[]

  @@unique([problemId, revision])
}

model TestCase {
  id               String         @id @default(cuid())
  problemVersionId String
  problemVersion   ProblemVersion @relation(fields: [problemVersionId], references: [id])
  index            Int
  isSample         Boolean        @default(false)
  inputSha256      String
  input            TestBlob       @relation("TestInput", fields: [inputSha256], references: [sha256])
  outputSha256     String
  output           TestBlob       @relation("TestOutput", fields: [outputSha256], references: [sha256])
  points           Int?
  subtaskIndex     Int?

  @@unique([problemVersionId, index])
}

/// SUBTASK scoring. Child of a version, so frozen with it.
model Subtask {
  id               String             @id @default(cuid())
  problemVersionId String
  problemVersion   ProblemVersion     @relation(fields: [problemVersionId], references: [id])
  index            Int
  points           Float
  aggregation      SubtaskAggregation @default(MIN)
  /// Subtask indexes that must be fully passed first; otherwise SKIPPED.
  dependsOn        Int[]              @default([])

  @@unique([problemVersionId, index])
}

/// Per-language limits derived from measured reference solutions (or the
/// fallback multiplier when no model solution exists in that language).
/// Child of a version, so frozen with it.
model ProblemLanguageLimit {
  id                   String         @id @default(cuid())
  problemVersionId     String
  problemVersion       ProblemVersion @relation(fields: [problemVersionId], references: [id])
  language             String
  timeLimitMs          Int
  memoryLimitKb        Int
  /// Max per-test CPU ms of the model solution in this language; null = fallback multiplier.
  measuredModelMs      Int?
  /// "workerVersion/node/calibrationScore" the measurement was taken on.
  measuredOnGeneration String?
  createdAt            DateTime       @default(now())

  @@unique([problemVersionId, language])
}

/// Content-addressed. Small blobs inline (≤ 64 KB); larger ones in object
/// storage under an immutable key. A blob is never mutated: the
/// TestBlob_immutable trigger refuses any UPDATE that changes sha256,
/// sizeBytes, inline or storageKey (a no-op upsert of an existing sha is fine),
/// and TestBlob_no_truncate refuses TRUNCATE. A blob no TestCase references
/// can still be deleted.
model TestBlob {
  id         String     @id @default(cuid())
  sha256     String     @unique
  sizeBytes  Int
  inline     String?    @db.Text
  storageKey String?
  createdAt  DateTime   @default(now())
  asInput    TestCase[] @relation("TestInput")
  asOutput   TestCase[] @relation("TestOutput")
}

model StarterCode {
  id               String         @id @default(cuid())
  problemVersionId String
  problemVersion   ProblemVersion @relation(fields: [problemVersionId], references: [id])
  language         String
  code             String         @db.Text

  @@unique([problemVersionId, language])
}

/// Model and deliberately-wrong solutions. The source is never returned to a
/// STUDENT by any query path (asserted by a Phase 4 test).
model ReferenceSolution {
  id               String          @id @default(cuid())
  problemVersionId String
  problemVersion   ProblemVersion  @relation(fields: [problemVersionId], references: [id])
  language         String
  label            String?
  source           String          @db.Text
  expectedVerdict  Verdict
  measuredMs       Int?
  createdAt        DateTime        @default(now())
  validationRuns   ValidationRun[]

  @@index([problemVersionId])
}

/// One row per (language, pinned toolchain). Upgrading a toolchain adds a
/// row; old rows stay so an old submission rejudges on its own toolchain.
model LanguageConfig {
  id             String          @id @default(cuid())
  key            String
  toolchainId    String
  version        String
  label          String
  /// The full LanguageRuntime (argv, env, limits). Fixed server-side.
  runtime        Json
  enabled        Boolean         @default(false)
  /// The row new submissions in this language use.
  isCurrent      Boolean         @default(false)
  createdAt      DateTime        @default(now())
  retiredAt      DateTime?
  submissions    Submission[]
  runRequests    RunRequest[]
  validationRuns ValidationRun[]

  @@unique([key, toolchainId])
}

// ── Submissions ────────────────────────────────────────────────────────

/// Narrow by design (~7M/year). Per-test results are a compact jsonb array
/// [{"i":0,"v":"AC","ms":12,"kb":2048}], never a row per test.
model Submission {
  id                  String           @id @default(cuid())
  userId              String
  user                User             @relation(fields: [userId], references: [id])
  problemId           String
  problem             Problem          @relation(fields: [problemId], references: [id])
  /// Pinned version — never the live pointer.
  problemVersionId    String
  problemVersion      ProblemVersion   @relation(fields: [problemVersionId], references: [id])
  languageConfigId    String
  languageConfig      LanguageConfig   @relation(fields: [languageConfigId], references: [id])
  language            String
  origin              SubmissionOrigin @default(PRACTICE)
  lane                JudgeLane        @default(PRACTICE)
  status              SubmissionStatus @default(QUEUED)
  judgeState          JudgeState       @default(PENDING)
  verdict             Verdict?
  score               Float?
  maxScore            Float?
  /// [{index, earned, max, verdict}] for SUBTASK scoring.
  subtaskResults      Json?
  /// Sum of per-test CPU ms — charged to the user's daily CPU budget.
  cpuMs               Int?
  testResults         Json?
  passedCases         Int              @default(0)
  totalCases          Int              @default(0)
  maxTimeMs           Int?
  maxMemoryKb         Int?
  firstFailedIndex    Int?
  compileOutput       String?          @db.Text
  /// Doubles as the exact-duplicate signal.
  sourceSha256        String
  sourceBytes         Int
  contestId           String?
  assessmentAttemptId String?
  claimedByNodeId     String?
  claimToken          String?
  leaseExpiresAt      DateTime?
  attemptCount        Int              @default(0)
  /// Node that produced the stored result + its calibration at the time, so
  /// a timing dispute is auditable.
  judgeNodeId         String?
  calibrationScore    Float?
  queuedAt            DateTime         @default(now())
  startedAt           DateTime?
  judgedAt            DateTime?
  createdAt           DateTime         @default(now())

  source  SubmissionSource?
  details SubmissionTestDetail[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, problemId, createdAt(sort: Desc)])
  @@index([problemId, verdict, createdAt(sort: Desc)])
  @@index([contestId, userId, problemId])
  @@index([assessmentAttemptId, problemVersionId, createdAt(sort: Desc)])
  @@index([judgeState, queuedAt])
  @@index([status, leaseExpiresAt])
  @@index([sourceSha256])
  @@index([createdAt])
}

/// 1:1 side table so list queries never drag 256 KB of source. CHECK
/// constraint (migration) caps octet_length at 256 KB.
model SubmissionSource {
  submissionId String     @id
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  source       String     @db.Text
  archivedAt   DateTime?
}

/// Visible-case output only: ≤ 4 KB per test, ≤ 32 KB per submission,
/// purged after 30 days. Hidden tests never get a row.
model SubmissionTestDetail {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  testIndex    Int
  input        String?    @db.Text
  expected     String?    @db.Text
  stdout       String?    @db.Text
  stderr       String?    @db.Text
  createdAt    DateTime   @default(now())

  @@unique([submissionId, testIndex])
  @@index([createdAt])
}

/// The editor's Run button: sample cases or custom stdin. No checker, no
/// scoring, no XP. 24h TTL.
model RunRequest {
  id               String           @id @default(cuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id])
  problemVersionId String
  problemVersion   ProblemVersion   @relation(fields: [problemVersionId], references: [id])
  languageConfigId String
  languageConfig   LanguageConfig   @relation(fields: [languageConfigId], references: [id])
  language         String
  source           String           @db.Text
  /// Null = run the sample tests.
  customInput      String?          @db.Text
  status           SubmissionStatus @default(QUEUED)
  judgeState       JudgeState       @default(PENDING)
  verdict          Verdict?
  /// [{i, v, ms, kb, stdout, stderr, expected?, input?}]
  result           Json?
  compileOutput    String?          @db.Text
  claimedByNodeId  String?
  claimToken       String?
  leaseExpiresAt   DateTime?
  attemptCount     Int              @default(0)
  judgeNodeId      String?
  createdAt        DateTime         @default(now())
  /// First claim — queue wait = startedAt − createdAt.
  startedAt        DateTime?
  judgedAt         DateTime?
  expiresAt        DateTime

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, leaseExpiresAt])
  @@index([expiresAt])
}

// ── Progress, XP and gamification (Phase 3) ────────────────────────────

/// The critical denormalisation that keeps the problem-list status column off
/// Submission. "Done" for study plans is status = SOLVED (one source of truth).
model UserProblemStatus {
  userId               String
  user                 User            @relation(fields: [userId], references: [id])
  problemId            String
  problem              Problem         @relation(fields: [problemId], references: [id])
  status               ProblemProgress
  /// Judged practice submissions (CE included, IE excluded).
  attempts             Int             @default(0)
  failedAttempts       Int             @default(0)
  firstAttemptAt       DateTime
  lastAttemptAt        DateTime
  firstAcceptedAt      DateTime?
  bestSubmissionId     String?
  /// The first solve came after a tier-3 hint or the editorial: it counts as
  /// solved, pays 40 % XP, and is excluded from unassisted readiness inputs.
  assisted             Boolean         @default(false)
  solvedLanguage       String?
  /// Active workspace seconds before the first AC (time-to-solve).
  activeSecondsToSolve Int?

  @@id([userId, problemId])
  @@index([userId, status, firstAcceptedAt(sort: Desc)])
  @@index([problemId, status])
  /// Phase 9b. The readiness job reads the per-difficulty unassisted counts
  /// in ONE grouped pass over the whole college (UserStats has only a single
  /// `assistedSolves` scalar, so the split needs this joined to Problem).
  /// One sequential scan rather than 5,000 queries, and this keeps it to the
  /// solved rows.
  @@index([status])
}

/// One row per user per campus (Asia/Kolkata) day with any activity: the
/// streak source, the heatmap, and the inactivity evidence.
model ActivityDay {
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  date          DateTime @db.Date
  submissions   Int      @default(0)
  accepted      Int      @default(0)
  /// First solves that day.
  solved        Int      @default(0)
  xp            Int      @default(0)
  /// XP from Easy first solves that day (the 600/day Easy cap).
  xpEasy        Int      @default(0)
  activeSeconds Int      @default(0)
  /// Aptitude questions answered in topic practice that day (Phase 7). A row
  /// has to exist for a student who only does aptitude, or Phase 8's nightly
  /// job cannot see them and the heatmap shows an empty year.
  aptitudeAnswers Int    @default(0)
  /// Full mocks finalised that day (Phase 7).
  mocksFinalised  Int    @default(0)
  /// XP from aptitude topic practice that day (the 200/day aptitude cap).
  /// Maintained here for the same reason xpEasy is: SPEC §4(d) forbids
  /// aggregating XpEvent on a request, and a cap that needs today's total
  /// needs it from a maintained row.
  xpAptitude      Int    @default(0)

  @@id([userId, date])
  @@index([date])
  @@index([userId, date(sort: Desc)])
}

model UserStats {
  userId         String    @id
  user           User      @relation(fields: [userId], references: [id])
  solvedEasy     Int       @default(0)
  solvedMedium   Int       @default(0)
  solvedHard     Int       @default(0)
  solvedTotal    Int       @default(0)
  assistedSolves Int       @default(0)
  submissions    Int       @default(0)
  accepted       Int       @default(0)
  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  lastActiveDate DateTime? @db.Date
  xpTotal        Int       @default(0)
  /// Solves per language, e.g. {"cpp20": 12, "py312": 3}.
  languageCounts Json      @default("{}")
  /// Unassisted first solves per topic, e.g. {"GRAPHS": 4}.
  topicSolved    Json      @default("{}")
  /// Assisted first solves per topic.
  topicAssisted  Json      @default("{}")
  updatedAt      DateTime  @updatedAt
}

/// Append-only XP ledger: no UPDATE, no DELETE (trigger XpEvent_append_only +
/// test) and no TRUNCATE (trigger XpEvent_no_truncate, 20261010100080).
/// Voiding XP writes a compensating REVERSAL row. Pages never aggregate this
/// table; they read XpBucket (tests/repo/xp-ledger.test.ts).
model XpEvent {
  id              BigInt      @id @default(autoincrement())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  kind            XpEventKind
  amount          Int
  /// solve:{userId}:{problemId}, streak:{userId}:{milestone},
  /// contest:{contestId}:{userId}:participation, daily:{userId}:{yyyy-MM-dd}
  idempotencyKey  String      @unique
  rulesVersion    Int
  problemId       String?
  submissionId    String?
  contestId       String?
  assessmentId    String?
  reversesEventId BigInt?
  grantedById     String?
  meta            Json        @default("{}")
  occurredAt      DateTime    @default(now())

  @@index([userId, occurredAt])
}

/// Period buckets the leaderboards read: one ordered index scan per board.
model XpBucket {
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  period         XpPeriod
  /// "all" | "2026-10" | "2026-W41" (ISO week, Asia/Kolkata).
  periodKey      String
  xp             Int      @default(0)
  solvedEasy     Int      @default(0)
  solvedMedium   Int      @default(0)
  solvedHard     Int      @default(0)
  batchYear      Int?
  departmentCode String?
  section        String?
  lastXpAt       DateTime

  @@unique([period, periodKey, userId])
  @@index([period, periodKey, xp(sort: Desc), lastXpAt(sort: Asc)])
  @@index([period, periodKey, batchYear, xp(sort: Desc), lastXpAt(sort: Asc)])
  @@index([period, periodKey, departmentCode, xp(sort: Desc), lastXpAt(sort: Asc)])
  @@index([period, periodKey, batchYear, departmentCode, section, xp(sort: Desc), lastXpAt(sort: Asc)])
}

/// Closed periods freeze into a snapshot (top 200) so historical boards stop being written.
model LeaderboardSnapshot {
  id        String   @id @default(cuid())
  period    XpPeriod
  periodKey String
  /// COLLEGE | DEPARTMENT | BATCH | SECTION
  scope     String
  /// "" for COLLEGE; "CSE", "2027" or "2027:CSE:A" otherwise.
  scopeKey  String
  top       Json
  frozenAt  DateTime @default(now())

  @@unique([period, periodKey, scope, scopeKey])
}

/// Daily challenge: 2x XP on a first solve that day.
model DailyChallenge {
  date        DateTime @id @db.Date
  problemId   String
  problem     Problem  @relation(fields: [problemId], references: [id])
  createdById String?
}

model Badge {
  id          String      @id @default(cuid())
  key         String      @unique
  name        String
  description String
  /// lucide icon name, always rendered with its text (never colour alone).
  icon        String
  sortOrder   Int         @default(0)
  users       UserBadge[]
}

model UserBadge {
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id])
  awardedAt DateTime @default(now())

  @@id([userId, badgeId])
}

// ── Hints and editorials (Phase 3) ─────────────────────────────────────

/// Tiered hints are version content, frozen with the version.
model Hint {
  id               String         @id @default(cuid())
  problemVersionId String
  problemVersion   ProblemVersion @relation(fields: [problemVersionId], references: [id])
  /// 1, 2 or 3.
  tier             Int
  contentMd        String         @db.Text
  reveals          HintReveal[]

  @@unique([problemVersionId, tier])
}

model Editorial {
  id               String         @id @default(cuid())
  problemVersionId String         @unique
  problemVersion   ProblemVersion @relation(fields: [problemVersionId], references: [id])
  contentMd        String         @db.Text
}

model HintReveal {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  problemId  String
  problem    Problem     @relation(fields: [problemId], references: [id])
  hintId     String
  hint       Hint        @relation(fields: [hintId], references: [id])
  tier       Int
  context    HelpContext
  revealedAt DateTime    @default(now())

  @@unique([userId, hintId])
  @@index([userId, problemId])
}

model EditorialView {
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  problemId     String
  problem       Problem  @relation(fields: [problemId], references: [id])
  firstViewedAt DateTime @default(now())

  @@id([userId, problemId])
}

/// One question put to the AI helper and the answer it gave.
///
/// Kept for three reasons, in order: a solve that followed one is ASSISTED
/// and the finaliser reads this table exactly as it reads HintReveal; the
/// student can reopen what they were told without asking again; and somebody
/// has to be able to audit what the college spent and what the model said.
///
/// The student's own draft is NOT stored. It is already in CodeDraft, and a
/// second copy is a second thing to leak. The answer is, because a student
/// may reread it and a reviewer may need to see it.
///
/// Practice only. The context column exists to say so in the data and carry
/// the CHECK, not because another value is reachable.
model AiAssist {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  problemId String
  problem   Problem     @relation(fields: [problemId], references: [id])
  context   HelpContext @default(PRACTICE)
  kind      AiAskKind
  /// The model that answered, as chosen in /super/settings/ai at the time.
  modelId   String
  /// Null exactly when the ask failed: a failure costs no quota and taints
  /// no solve, because the student was told nothing.
  answer    String?
  failed    Boolean     @default(false)
  tokensIn  Int?
  tokensOut Int?
  latencyMs Int?
  askedAt   DateTime    @default(now())

  @@index([userId, problemId])
  @@index([userId, askedAt])
}

/// Active (focused, recently typing) workspace time per user per problem:
/// the "active minutes" that unlock hint tiers.
model ProblemActivity {
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  problemId     String
  problem       Problem  @relation(fields: [problemId], references: [id])
  activeSeconds Int      @default(0)
  lastPingAt    DateTime @default(now())

  @@id([userId, problemId])
}

// ── Study plans, bookmarks, notes, notifications, drafts (Phase 3) ─────

model StudyPlan {
  id          String                @id @default(cuid())
  slug        String                @unique
  kind        StudyPlanKind
  title       String
  description String                @db.Text
  published   Boolean               @default(false)
  sortOrder   Int                   @default(0)
  /// Maintained: number of items in the plan.
  itemsTotal  Int                   @default(0)
  /// Owned by the seed (scripts/content/study-plans.ts): /admin edits of
  /// these plans would be overwritten on the next seed, so admin treats
  /// them as read-only. Set for the seeded plans by the Phase 4 migration.
  seedManaged Boolean               @default(false)
  createdById String?
  updatedById String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  sections    StudyPlanSection[]
  items       StudyPlanItem[]
  enrollments StudyPlanEnrollment[]
}

model StudyPlanSection {
  id        String          @id @default(cuid())
  planId    String
  plan      StudyPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  title     String
  sortOrder Int             @default(0)
  items     StudyPlanItem[]
}

model StudyPlanItem {
  id        String           @id @default(cuid())
  planId    String
  plan      StudyPlan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  sectionId String
  section   StudyPlanSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  problemId String
  problem   Problem          @relation(fields: [problemId], references: [id])
  sortOrder Int              @default(0)

  @@unique([planId, problemId])
  @@index([problemId])
}

/// itemsDone is maintained from UserProblemStatus (status = SOLVED); there is
/// no per-item progress table.
model StudyPlanEnrollment {
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  planId      String
  plan        StudyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  itemsTotal  Int       @default(0)
  itemsDone   Int       @default(0)
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?

  @@id([userId, planId])
  @@index([planId])
}

model Bookmark {
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  problemId String
  problem   Problem  @relation(fields: [problemId], references: [id])
  createdAt DateTime @default(now())

  @@id([userId, problemId])
  @@index([userId, createdAt(sort: Desc)])
}

/// Private to the student. Never visible to PLACEMENT_OFFICER (Phase 9 guard + test).
model Note {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  problemId String?
  problem   Problem? @relation(fields: [problemId], references: [id])
  title     String?
  contentMd String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt(sort: Desc)])
}

model Notification {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  kind           String
  title          String
  body           String
  link           String?
  readAt         DateTime?
  createdAt      DateTime      @default(now())
  /// Kind "announcement": the Announcement this row was fanned out from.
  announcementId String?
  announcement   Announcement? @relation(fields: [announcementId], references: [id])

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@index([announcementId, readAt])
}

/// Server copy of the editor draft; the browser keeps an IndexedDB copy too
/// and the newer of the two wins. Private to the student.
model CodeDraft {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  problemId       String
  problem         Problem  @relation(fields: [problemId], references: [id])
  language        String
  source          String   @db.Text
  /// When the browser saved it (newest-wins comparison with the local copy).
  clientUpdatedAt DateTime
  updatedAt       DateTime @updatedAt

  @@unique([userId, problemId, language])
}

/// A reference solution judged at authoring/publish time (judge job kind
/// "validation"): measures per-language limits and proves model solutions
/// pass and deliberately-wrong ones fail. Generous limits, never scored.
model ValidationRun {
  id                  String            @id @default(cuid())
  problemVersionId    String
  problemVersion      ProblemVersion    @relation(fields: [problemVersionId], references: [id])
  referenceSolutionId String
  referenceSolution   ReferenceSolution @relation(fields: [referenceSolutionId], references: [id])
  language            String
  languageConfigId    String
  languageConfig      LanguageConfig    @relation(fields: [languageConfigId], references: [id])
  status              SubmissionStatus  @default(QUEUED)
  judgeState          JudgeState        @default(PENDING)
  verdict             Verdict?
  outcome             ValidationOutcome @default(PENDING)
  /// Max per-test CPU ms.
  measuredMs          Int?
  testResults         Json?
  compileOutput       String?           @db.Text
  claimedByNodeId     String?
  claimToken          String?
  leaseExpiresAt      DateTime?
  attemptCount        Int               @default(0)
  judgeNodeId         String?
  calibrationScore    Float?
  requestedById       String?
  createdAt           DateTime          @default(now())
  /// First claim — queue wait = startedAt − createdAt.
  startedAt           DateTime?
  judgedAt            DateTime?
  /// ProblemVersion.judgeSeq when this run was requested. Only runs whose
  /// seq equals the version's current judgeSeq count toward publishing.
  judgeSeq            Int               @default(0)

  @@index([problemVersionId, createdAt(sort: Desc)])
  @@index([status, leaseExpiresAt])
}

/// Daily judge usage per user (Asia/Kolkata calendar day), maintained in the
/// finalise transaction. Backs the 300 practice/day and 20 CPU-min/day caps.
model UserJudgeUsage {
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  day         DateTime @db.Date
  submissions Int      @default(0)
  runs        Int      @default(0)
  cpuMs       BigInt   @default(0)
  updatedAt   DateTime @updatedAt

  @@id([userId, day])
}

/// Admin override of a user's judge caps (audited). Null fields keep the default.
model JudgeQuotaOverride {
