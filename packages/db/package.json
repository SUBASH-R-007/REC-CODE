{
  "name": "@recx/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Prisma schema, migrations and the guarded client for the recx database. Imported by apps/web and apps/scheduler only — never by apps/judge-worker.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./audit": "./src/audit.ts",
    "./audit-chain": "./src/audit-chain.ts",
    "./attempt": "./src/attempt.ts",
    "./mock": "./src/mock.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "6.16.2",
    "@recx/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "prisma": "6.16.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
